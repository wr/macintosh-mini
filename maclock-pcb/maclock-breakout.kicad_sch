	(text "R3 + C1: 16 kHz low-pass on the Pi's PWM audio.\nC2/R4 and C3/R5 feed the differential input; with the\nPAM8302A's internal 10k the gain is about 9 dB.\nR6 holds SD high: the amplifier is always on.\nJ3 speaker: 8 ohm, 1 W, Molex PicoBlade plug;\npolarity does not matter."
		(exclude_from_sim no)
		(at 167.64 78.74 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "e2950185-f9e2-4825-9668-0e54f572a52e")
	)

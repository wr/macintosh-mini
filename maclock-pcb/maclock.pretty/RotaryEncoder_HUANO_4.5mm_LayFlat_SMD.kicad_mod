(footprint "RotaryEncoder_HUANO_4.5mm_LayFlat_SMD"
	(version 20260206)
	(generator "pcbnew")
	(generator_version "10.0")
	(layer "F.Cu")
	(descr "HUANO 4.5 mm mouse-wheel encoder (sold as MECCANIXITY, Amazon B0C13ZZVT5) laid on its back with the 1.74 mm hex bore up, pins pointing north and bent down onto top-side pads; the MP pads take the frame's two clip legs, bent down the same way. Origin = bore centre. HUANO publishes no drawing: the 9.6 mm width and 2.5 mm pin pitch are the listing's, and the bore sits about 4.4 mm from the pin edge and 3.5 mm from the domed end (estimated from the listing photo), so the pads run 2.8 mm north to catch the bent pins wherever they land. Pin order assumed C-B-A with the common at one end, as on HOAUC's and TT's mouse-wheel encoders; turning the part face-down swaps the two ends. Hand-fitted, so no paste.")
	(tags "encoder wheel mouse HUANO 4.5 hex bore lay flat")

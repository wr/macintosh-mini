(footprint "RotaryEncoder_EN10HT1212N5HH3_THT"
	(version 20260206)
	(generator "pcbnew")
	(generator_version "10.0")
	(layer "F.Cu")
	(descr "TT Electronics EN10HT1212N5HH3 top-adjust 10 mm encoder lying flat, hex bore up (1.75 +/-0.03 mm), 12 pulse / 12 detent, pins pointing west. Origin = bore centre. Land from TT's EN10 datasheet p.4, located on the bore with TT's STEP: pin holes 6.8 mm from the bore (5.5 from the tab line, which is 1.3 mm off the bore toward the pins), tab slot 2.2 x 1.55. Only the north tab gets a slot; on the maclock-breakout board the south tab falls past the board edge. Pads run 2.6 mm east of the holes so a laid-flat mouse-wheel encoder (Huano 4.5, HOAUC HYCW04) can be lap-soldered with its legs bent down. Body 5.2 mm tall including the 0.6 mm collar.")
	(tags "encoder wheel mouse TT EN10 EN10HT hex bore top adjust")

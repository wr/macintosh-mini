(footprint "C_Chip_or_Disc_P5mm_SMD"
  (version 20240108)
  (generator "konnect")
  (layer "F.Cu")
  (descr "Hybrid audio-cap land for maclock-breakout C1: two 2.0x1.5mm SMD pads (2.8mm pitch) plus two Ø0.8mm THT holes on 5mm pitch, so an SMD chip (0402-1206) or a through-hole disc both fit. SMD-classed with a chip 3D model.")
  (attr smd)
  (pad "1" thru_hole circle (at 0 0) (size 1.6 1.6) (layers "*.Cu" "*.Mask") (drill 0.8) )
  (pad "1" smd rect (at 1.1 0) (size 2 1.5) (layers "F.Cu" "F.Paste" "F.Mask")  )
  (pad "2" smd rect (at 3.9 0) (size 2 1.5) (layers "F.Cu" "F.Paste" "F.Mask")  )
  (pad "2" thru_hole circle (at 5 0) (size 1.6 1.6) (layers "*.Cu" "*.Mask") (drill 0.8) )
  (fp_rect (start -1.0500 -1.0500) (end 6.0500 1.0500) (stroke (width 0.05) (type solid)) (fill none) (layer "F.CrtYd"))
  (fp_rect (start -0.9500 -0.9500) (end 5.9500 0.9500) (stroke (width 0.12) (type solid)) (fill none) (layer "F.SilkS"))
  (fp_poly (pts (xy -0.8000 -0.4000) (xy -0.4000 -0.8000) (xy 5.8000 -0.8000) (xy 5.8000 0.8000) (xy -0.8000 0.8000)) (stroke (width 0.1) (type solid)) (fill none) (layer "F.Fab"))
  (fp_circle (center -1.3500 0.0000) (end -1.2000 0.0000) (stroke (width 0.1) (type solid)) (fill solid) (layer "F.SilkS"))
  (fp_text reference "REF**" (at 2.5000 -2.0500 0) (layer "F.SilkS") (effects (font (size 1 1) (thickness 0.15))))
  (fp_text value "C_Chip_or_Disc_P5mm_SMD" (at 2.5000 2.0500 0) (layer "F.Fab") (effects (font (size 1 1) (thickness 0.15))))
  (model "${KICAD9_3DMODEL_DIR}/Capacitor_SMD.3dshapes/C_1206_3216Metric.step"
    (offset (xyz 2.5 0 0))
    (scale (xyz 1 1 1))
    (rotate (xyz 0 0 0)))
)
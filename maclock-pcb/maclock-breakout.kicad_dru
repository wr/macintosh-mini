(version 1)
(rule "Pour 0.3 mm from board edge"
	(condition "A.Type == 'Zone'")
	(constraint edge_clearance (min 0.3mm)))

(rule "SOT-563 pad pitch around U4 (0.15 mm gaps between its own pads)"
	(condition "A.intersectsCourtyard('U4') || B.intersectsCourtyard('U4')")
	(constraint clearance (min 0.14mm)))

(rule "Tracks and vias 0.3 mm from board edges, like the pours"
	(condition "A.Type == 'Track' || A.Type == 'Via'")
	(constraint edge_clearance (min 0.3mm)))

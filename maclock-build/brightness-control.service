[Unit]
Description=Rotary encoder brightness control
# The backlight stays dark until this runs, so start it as soon as the root
# filesystem is up rather than queueing behind sysinit.target (cloud-init
# alone holds that for ~11s). The script waits for the PWM driver itself.
DefaultDependencies=no
After=local-fs.target
Before=sysinit.target getty@tty1.service shutdown.target
Conflicts=shutdown.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/bin/brightness_control.py
Restart=always
RestartSec=2

[Install]
WantedBy=sysinit.target
